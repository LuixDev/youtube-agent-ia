# ============================
# Configuración del Agente IA
# ============================

# xAI (Grok) API Key (requerido para generación de guiones e imágenes)
# Obtén tu clave en: https://console.x.ai/
XAI_API_KEY=xai-tu-clave-aqui

# Modelo de Grok para generación de guiones
XAI_MODEL=grok-3

# Modelo de Grok para generación de imágenes
XAI_IMAGE_MODEL=grok-2-image

# YouTube API - OAuth2 Credentials
# Obtén estas credenciales en: https://console.cloud.google.com/apis/credentials
YOUTUBE_CLIENT_ID=tu-client-id
YOUTUBE_CLIENT_SECRET=tu-client-secret

# Voz de Edge TTS para español
# Opciones: es-MX-DaliaNeural, es-MX-JorgeNeural, es-ES-ElviraNeural, es-ES-AlvaroNeural
TTS_VOICE=es-MX-JorgeNeural

# Directorio de salida para videos generados
OUTPUT_DIR=./output

# Duración objetivo del video en segundos (default: 480 = 8 minutos)
TARGET_DURATION=480

# Resolución del video
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080

# Categoría de YouTube (27 = Educación)
YOUTUBE_CATEGORY_ID=27

# Privacidad por defecto: public, unlisted, private
YOUTUBE_PRIVACY=public
